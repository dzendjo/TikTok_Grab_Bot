# Bot
BOT_TOKEN=your_bot_token_here
BOT_NAME=YtbVideoBot
ADMIN_IDS=2519539,791380027

# Database
DB_HOST=localhost
DB_PORT=27017
DB_NAME=YtbVideoBot

# Redis (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Webhook (optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Domain for traefik router in docker-compose.prod.yml
WEBHOOK_DOMAIN=ytbvideobot.fastbots.net

# NATS (YT-API manager: downloads + status updates)
NATS_URI=nats://135.181.26.26:4222
NATS_TOKEN=your_nats_token
NATS_MANAGER_NAME=manager
NATS_META_TIMEOUT_SECONDS=10
NATS_DOWNLOAD_TIMEOUT_SECONDS=3
NATS_TRANSCRIPT_TIMEOUT_SECONDS=60

# Premium (Telegram Stars). PREMIUM_ENABLED=false turns the paywall off
# (all qualities/sizes free again); paid users still skip ads.
PREMIUM_ENABLED=true
PREMIUM_MONTH_STARS=99
PREMIUM_QUARTER_STARS=249
PREMIUM_YEAR_STARS=799
SINGLE_DOWNLOAD_STARS=10
FREE_DAILY_DOWNLOADS=3
# 0 = no free size cap (Telegram's 2 GB limit still applies)
FREE_MAX_FILE_MB=500

# Localization
DEFAULT_LANGUAGE=uk
AVAILABLE_LANGUAGES=uk,en,ru

# Telegram channels where bot is allowed to search/reuse files
# Supports CSV or JSON array format
ALLOWED_SOURCE_CHANNEL_IDS=[-1001624462711,-1001657251150]

# Legacy advert API (optional)
# AD_TOKEN=your_ad_token
API_URL_AVAILABLE_CAMPAIGNS=https://addpromoapi.fastbots.net/available-adverts
API_URL_GET_ADVERT=https://addpromoapi.fastbots.net/get-advert

# BotAdsLib advert system (template-compatible)
AD_API_BASE_URL=
AD_BOT_HASH=
AD_CACHE_CHANNEL_ID=
ALLOWED_CHANNEL_IDS=
AD_MEDIA_CACHE_PATH=.botads-media-cache.json

# Logging
LOG_LEVEL=INFO
