# Bot
BOT_TOKEN=your_bot_token_here
BOT_NAME=tiktok_grab_bot
ADMIN_IDS=2519539,791380027

# Database
DB_HOST=localhost
DB_PORT=27017
DB_NAME=TikTokBot

# Redis (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Webhook (optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Domain for traefik router in docker-compose.prod.yml
WEBHOOK_DOMAIN=tiktokgrabbot.fastbots.net

# NATS (YT-API TikTok stack on 65.21.205.145: downloads + status updates).
# NATS listens on 127.0.0.1:4224 there; locally use an SSH tunnel:
#   ssh -N -L 14224:127.0.0.1:4224 root@65.21.205.145
NATS_URI=nats://127.0.0.1:14224
NATS_TOKEN=your_nats_token
NATS_MANAGER_NAME=manager
NATS_META_TIMEOUT_SECONDS=10
NATS_DOWNLOAD_TIMEOUT_SECONDS=3

# Premium (Telegram Stars). PREMIUM_ENABLED=false turns the paywall off
# (no daily limit for anyone); paid users still skip ads.
PREMIUM_ENABLED=true
PREMIUM_MONTH_STARS=99
PREMIUM_QUARTER_STARS=249
PREMIUM_YEAR_STARS=799
SINGLE_DOWNLOAD_STARS=10
FREE_DAILY_DOWNLOADS=30

# Localization
DEFAULT_LANGUAGE=uk
AVAILABLE_LANGUAGES=uk,en,ru

# TikTok upload channels (UPLOAD_CHANNELS_JSON of the stack); the bot must be
# an admin there. Supports CSV or JSON array format.
ALLOWED_SOURCE_CHANNEL_IDS=[]

# Legacy advert API (optional)
# AD_TOKEN=your_ad_token
API_URL_AVAILABLE_CAMPAIGNS=https://addpromoapi.fastbots.net/available-adverts
API_URL_GET_ADVERT=https://addpromoapi.fastbots.net/get-advert

# BotAdsLib advert system (template-compatible)
AD_API_BASE_URL=https://webbotadvert.fastbots.net
AD_BOT_HASH=
AD_CACHE_CHANNEL_ID=
ALLOWED_CHANNEL_IDS=
AD_MEDIA_CACHE_PATH=.botads-media-cache.json

# Logging
LOG_LEVEL=INFO
